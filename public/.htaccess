ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Change only the domain root; keep customer DirectoryIndex/MultiViews settings.
  RewriteRule ^$ index.html [L]
  RewriteRule ^index\.html$ - [L]

  # Preserve the live site's existing customer URL redirects.
  RewriteRule ^styop-varduhi/?(.*)$ /varduhi-styop/$1 [R=301,L]
  RewriteRule ^avo-anna/?(.*)$ /anna-avo/$1 [R=301,L]

  # Preserve the existing PHP handler and any additional query parameters.
  RewriteRule ^preview/([^/]+)/?$ preview.php?code=$1 [L,QSA]

  # Retired templates remain unavailable even if old hosting files are retained.
  RewriteRule ^templates/07[78](?:/.*|\.html)?$ - [R=404,L]

  # The React viewer and standalone invitation are separate documents.
  RewriteCond %{DOCUMENT_ROOT}/templates/$1.html -f
  RewriteRule ^templates/([0-9]{3})/?$ templates/$1.html [L]
  RewriteRule ^templates/?$ templates/index.html [L]
  RewriteRule ^corporate/?$ corporate/index.html [L]

  # Existing customer files, directories and symlinks keep normal Apache handling.
  # Use L (not END) above so customer subdirectory .htaccess rules still run.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^ - [R=404,L]
</IfModule>
